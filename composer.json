{
  "name": "leuchtfeuer/mautic-companypoints-bundle",
  "description": "Massively enhanced Company-based Scoring. Point-based and even other (!) triggers and multiple triggered actions, all that for Companies.",
  "type": "mautic-plugin",
  "license": "GPL-3.0-or-later",
  "authors": [
      {
          "name": "Leuchtfeuer Digital Marketing GmbH",
          "email": "mautic-plugins@Leuchtfeuer.com",
          "homepage": "https://Leuchtfeuer.com/mautic/",
          "role": "Developer"
      }
  ],
  "keywords": [
    "mautic",
    "plugin",
    "integration"
  ],
  "extra": {
      "install-directory-name": "LeuchtfeuerCompanyPointsBundle"
  },
  "minimum-stability": "dev",
  "require": {
    "php": "^8.1",
    "mautic/core-lib": "^6.0",
    "leuchtfeuer/mautic-companysegments-bundle": "^6.0",
    "leuchtfeuer/mautic-companytags-bundle": "^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "MauticPlugin\\LeuchtfeuerCompanyPointsBundle\\" : ""
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "php-http/discovery": false
    }
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/mautic/FOSOAuthServerBundle.git"
    },
    {
      "type": "git",
      "url": "https://github.com/mautic/BazingaOAuthServerBundle.git"
    },
    {
      "type": "git",
      "url": "https://github.com/mautic/SpBundle.git",
      "canonical": false
    },
    {
      "type": "git",
      "url": "https://github.com/mautic/SymfonyBridgeBundle.git",
      "canonical": false
    }
  ]
}
